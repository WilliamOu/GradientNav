mergeInto(LibraryManager.library, {  OpenZipPicker: function () {    try {      var input = document.createElement('input');      input.type = 'file';      input.accept = '.zip,application/zip';      input.style.display = 'none';      input.onchange = function () {        try {          if (!input.files || input.files.length === 0) {            SendMessage('Zip Import Manager', 'WebGL_OnZipError', 'No file selected');            document.body.removeChild(input);            return;          }          var file = input.files[0];          SendMessage('Zip Import Manager', 'WebGL_OnZipSelectedName', file.name);          var reader = new FileReader();          reader.onload = function () {            try {              var bytes = new Uint8Array(reader.result);              // Send smaller chunks to avoid stack/memory issues              var chunkSize = 64 * 1024; // 64KB is safe              for (var i = 0; i < bytes.length; i += chunkSize) {                var sub = bytes.subarray(i, Math.min(i + chunkSize, bytes.length));                var b64 = uint8ToBase64(sub);                SendMessage('Zip Import Manager', 'WebGL_OnZipChunkBase64', b64);              }              SendMessage('Zip Import Manager', 'WebGL_OnZipDone', '');              document.body.removeChild(input);            } catch (err) {              SendMessage('Zip Import Manager', 'WebGL_OnZipError', '' + err);              document.body.removeChild(input);            }          };          reader.onerror = function () {            SendMessage('Zip Import Manager', 'WebGL_OnZipError', 'FileReader error');            document.body.removeChild(input);          };          reader.readAsArrayBuffer(file);        } catch (err) {          SendMessage('Zip Import Manager', 'WebGL_OnZipError', '' + err);          document.body.removeChild(input);        }      };      // Safe base64 encoder without Function.apply      function uint8ToBase64(u8) {        var CHUNK = 0x8000; // 32KB string chunks        var index = 0;        var length = u8.length;        var result = '';        var slice;        while (index < length) {          slice = u8.subarray(index, Math.min(index + CHUNK, length));          var str = '';          for (var i = 0; i < slice.length; i++) {            str += String.fromCharCode(slice[i]);          }          result += str;          index += CHUNK;        }        return btoa(result);      }      document.body.appendChild(input);      input.click();    } catch (err) {      SendMessage('Zip Import Manager', 'WebGL_OnZipError', '' + err);    }  }});